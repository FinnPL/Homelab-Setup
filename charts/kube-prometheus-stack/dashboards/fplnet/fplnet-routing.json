      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "state-timeline",
      "title": "Sessions",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "up",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "down",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (router, name) (bird_protocol_up{job=\"fplnet-bird\", proto=\"BGP\", router=~\"$router\"})",
          "legendFormat": "{{router}} {{name}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Prefixes per session",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Imported",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "service": true,
              "prometheus": true
            },
            "indexByName": {
              "router": 0,
              "name": 1
            },
            "renameByName": {
              "router": "Router",
              "name": "Session",
              "Value #A": "Imported",
              "Value #B": "Filtered",
              "Value #C": "Best",
              "Value #D": "Exported"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (router, name) (bird_protocol_prefix_import_count{job=\"fplnet-bird\", proto=\"BGP\", router=~\"$router\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (router, name) (bird_protocol_prefix_filter_count{job=\"fplnet-bird\", proto=\"BGP\", router=~\"$router\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (router, name) (bird_protocol_prefix_preferred_count{job=\"fplnet-bird\", proto=\"BGP\", router=~\"$router\"})",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (router, name) (bird_protocol_prefix_export_count{job=\"fplnet-bird\", proto=\"BGP\", router=~\"$router\"})",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
