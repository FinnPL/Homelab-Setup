      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(tetragon_events_total{type=\"PROCESS_EXEC\"}[24h]))",
          "legendFormat": "",
