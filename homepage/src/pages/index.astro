---
import Base from "../layouts/Base.astro";
import { projects } from "../lib/projects";
import { IDENTITY } from "../lib/identity";
import { ASN, AGGREGATE, CONNECTION, LOOKING_GLASS } from "../lib/net";
import { stamp } from "../lib/build";

const { featured, fetchedAt } = await projects();
const shown = featured.filter((p) => p.home !== false);
---

<Base
  title={IDENTITY.name}
  description="Computer science student at RWTH Aachen. Homelab infrastructure, networks, and the CI that deploys them."
>
  <div class="wrap hero">
    <h1>{IDENTITY.name}</h1>
    <p class="lede">
      I study computer science at RWTH Aachen and run the networks for two student dorms.
      In my free time I tinker with a three-site homelab running Kubernetes, and
      the CI that deploys it.
    </p>
    <a class="more" href="/about">More about me →</a>
  </div>

  <div class="wrap">
    <section class="net" aria-label="Network">
      <div class="net-head">
        <div class="nh-id"><span class="title">{ASN}</span><span class="pfx">{AGGREGATE}</span></div>
        <nav class="nh-links">
          <a href="https://fplnet.net/">fplnet.net →</a>
          <a href={LOOKING_GLASS}>Looking glass →</a>
          <a href={CONNECTION}>Your connection →</a>
          <a href="/status">Status →</a>
        </nav>
        <div class="nh-stats" id="nh-stats"></div>
      </div>
      <div class="net-body">
        <div class="map">
          <svg id="map" viewBox="12 32 976 590" role="img" aria-label="Network map: edge routers in Amsterdam, Düsseldorf and Frankfurt joined by a WireGuard backbone, with the Vieta and Minerva sites below">
            <g id="g-sites"></g><g id="g-links"></g><g id="g-pkts"></g><g id="g-labels"></g><g id="g-nodes"></g>
          </svg>
          <noscript>The map draws live data from the edge routers and needs JavaScript.</noscript>
        </div>
        <aside class="side"><div class="side-scroll" id="side-scroll" aria-live="polite"></div></aside>
      </div>
    </section>
  </div>

  <section class="wrap sec" id="sites">
    <div class="sec-head"><span class="eyebrow">Sites</span></div>
    <div class="grid two">
      <a class="card big" href="/vieta">
        <div class="where">Aachen</div>
        <h3>Vieta</h3>
        <p>The main Kubernetes cluster, in a 10" mini rack. Talos on Proxmox and three Raspberry Pis.</p>
        <dl class="facts">
          <dt>hosts</dt><dd>Intel NUC, 3 Raspberry Pi 4</dd>
          <dt>cluster</dt><dd>1 control plane, 4 workers</dd>
          <dt>network</dt><dd>Cilium, Gateway API, dual-stack</dd>
          <dt>uplink</dt><dd>gw1.aah1 to all three edges</dd>
        </dl>
        <span class="go">Hardware and software →</span>
      </a>
      <a class="card big" href="/minerva">
        <div class="where">Freiburg · not moved yet</div>
        <h3>Minerva</h3>
        <p>The second site. A Proxmox box with a pull-only backup NAS.</p>
        <dl class="facts">
          <dt>hosts</dt><dd>Proxmox on a Ryzen box, 32 GB</dd>
          <dt>storage</dt><dd>ZFS mirror, 2 × 8 TB SAS</dd>
          <dt>cluster</dt><dd><span class="nb">not built yet</span></dd>
          <dt>uplink</dt><dd><span class="nb">not built yet</span></dd>
        </dl>
        <span class="go">Hardware and software →</span>
      </a>
    </div>
  </section>

  <section class="wrap sec" id="fplnet">
    <div class="sec-head"><span class="eyebrow">Network</span><a href="https://fplnet.net/">fplnet.net →</a></div>
    <a class="card big" href="https://fplnet.net/">
      <div class="where">{ASN}</div>
      <h3>FPLNET</h3>
      <p>My own autonomous system. Three edge routers announce it, a WireGuard backbone joins them and the sites.</p>
      <dl class="facts">
        <dt>prefix</dt><dd class="mono">{AGGREGATE}</dd>
        <dt>edges</dt><dd>Düsseldorf, Amsterdam, Frankfurt</dd>
        <dt>exchanges</dt><dd>LocIX Düsseldorf, InterIX Amsterdam</dd>
        <dt>routing</dt><dd>BIRD 3, RPKI origin validation, anycast</dd>
      </dl>
      <span class="go">fplnet.net →</span>
    </a>
  </section>

  <section class="wrap sec" id="services">
    <div class="sec-head"><span class="eyebrow">Services</span></div>
    <div class="grid two">
      <a class="card" href="/dns">
        <h3>DNS</h3>
        <div class="host">dns.relay.lippok.dev</div>
        <p>Blocky filters, Unbound validates DNSSEC and forwards over TLS. Answered on an anycast address.</p>
      </a>
      <a class="card" href="/ntp">
        <h3>NTP</h3>
        <div class="host">not public yet</div>
        <p>Stratum 1 time from a GPS-disciplined oscillator. The PPS edge is timestamped by an Intel i210, chrony disciplines the clock to it.</p>
      </a>
    </div>
  </section>

  <section class="wrap sec" id="repos">
    <div class="sec-head"><span class="eyebrow">Repos</span><a href="/repos">All repos →</a></div>
    <div class="grid">
      {shown.map((p) => (
        <a class="card" href={`https://github.com/${p.slug}`}>
          <h3>{p.title}</h3>
          <p>{p.summary}</p>
          <div class="chips">{p.topics.slice(0, 5).map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </div>
    <p class="sourced" style="margin-top:12px">
      from the GitHub API · <time datetime={fetchedAt.toISOString()}>{stamp(fetchedAt)}</time>
    </p>
  </section>

  <section class="wrap sec" id="status">
    <div class="sec-head"><span class="eyebrow">Status, 30 days</span><a href="/status">90 days →</a></div>
    <div class="uptime"><ul id="uptime-rows"></ul><p class="sourced" id="uptime-stamp"></p></div>
  </section>
</Base>

<script>
  import "../scripts/map";
  import { renderStatus } from "../scripts/status";
  renderStatus(document.getElementById("uptime-rows")!, document.getElementById("uptime-stamp"), 30);
</script>
