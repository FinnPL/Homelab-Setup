      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(prometheus_tsdb_storage_blocks_bytes{job=\"kube-prometheus-stack-prometheus\"} + prometheus_tsdb_wal_storage_size_bytes{job=\"kube-prometheus-stack-prometheus\"})",
          "legendFormat": "Prometheus",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(cnpg_pg_database_size_bytes{namespace=\"cnpg-system\"}) + sum(cnpg_collector_pg_wal{namespace=\"cnpg-system\", value=\"size\"})",
          "legendFormat": "Postgres (databases + WAL)",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(node_filesystem_size_bytes{job=\"node-exporter\", mountpoint=\"/var\"} - node_filesystem_avail_bytes{job=\"node-exporter\", mountpoint=\"/var\"} * on (instance) group_left () (node_uname_info{job=\"node-exporter\", nodename=~\".*\"} * on (nodename) group_left () label_replace(kube_node_spec_taint{key=\"dedicated\", value=\"database\"}, \"nodename\", \"$1\", \"node\", \"(.*)\"))) - sum(prometheus_tsdb_storage_blocks_bytes{job=\"kube-prometheus-stack-prometheus\"} + prometheus_tsdb_wal_storage_size_bytes{job=\"kube-prometheus-stack-prometheus\"}) - (sum(cnpg_pg_database_size_bytes{namespace=\"cnpg-system\"}) + sum(cnpg_collector_pg_wal{namespace=\"cnpg-system\", value=\"size\"}))",
          "legendFormat": "rest (images, Loki, other volumes)",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 16,
        "h": 8
      }
    },
