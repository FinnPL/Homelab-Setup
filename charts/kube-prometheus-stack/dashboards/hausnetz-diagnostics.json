          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(rate(ifHCOutOctets{job=\"network_switches\", ifAlias!=\"\"}[5m]) * 8) / clamp_min(ifHighSpeed{job=\"network_switches\"} * 1000000, 1)",
          "legendFormat": "{{switch_name}} {{ifName}} {{ifAlias}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Trunk utilisation vs link speed",
      "type": "timeseries"
