      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "service": true,
              "prometheus": true
            },
            "indexByName": {
              "exported_namespace": 0,
              "workload": 1,
              "binary": 2
            },
            "renameByName": {
              "exported_namespace": "Namespace",
              "workload": "Workload",
              "binary": "Binary",
              "Value": "Executions"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(topk(25, sum by (exported_namespace, workload, binary) (round(increase(tetragon_events_total{type=\"PROCESS_EXEC\"}[24h]))) > 0), \"exported_namespace\", \"host\", \"exported_namespace\", \"\")",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
