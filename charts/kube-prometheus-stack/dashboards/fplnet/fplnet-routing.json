    "fplnet"
  ],
  "schemaVersion": 42,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "router",
        "label": "Router",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"fplnet-node\"}, router)",
          "refId": "router"
        },
        "definition": "label_values(up{job=\"fplnet-node\"}, router)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
