refclock SOCK /run/chrony.gpsdo.sock refid GPSS poll 2 filter 1 noselect
refclock PHC /dev/ptp-ntp0:extpps:pin=0 refid PPS poll 0 lock GPSS maxlockage 8 width 0.00005 prefer

hwtimestamp ntp0
bindaddress {{ vieta_hosts.ntp1.ipv4 }}
bindaddress {{ ntp_v6 }}
allow
ratelimit interval 1 burst 16
clientloglimit 16777216

leapseclist /usr/share/zoneinfo/leap-seconds.list
rtcsync
makestep 1 3
