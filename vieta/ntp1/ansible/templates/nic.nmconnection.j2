[connection]
id={{ item.name }}
type=ethernet
interface-name={{ item.name }}
autoconnect=true

[ethernet]

[ipv4]
method=manual
address1={{ item.ipv4 }}/{{ lan_prefix }},{{ lan.gateway }}
dns={{ lan.gateway }};
{% if item.table is defined %}
route-table={{ item.table }}
routing-rule1=priority 100 from {{ item.ipv4 }} table {{ item.table }}
{% endif %}

[ipv6]
{% if item.ipv6 is defined %}
method=manual
address1={{ item.ipv6 }}/64,{{ item.gateway6 }}
route-table={{ item.table }}
routing-rule1=priority 100 from {{ item.ipv6 }} table {{ item.table }}
{% else %}
method=disabled
{% endif %}
